{
  "_comment": "Seis inbounds 3x-ui propios del panel. HAProxy comparte las rutas WS por 80/8080 HTTP y 443/8443 TLS; gRPC usa 443/8443 TLS/H2.",
  "_reserved_by_others": {
    "xray_manager": { "ports": [10002, 10003, 10004, 10012, 10013, 10014], "paths": ["/vmess", "/vless", "/trojan-ws", "/vmess-grpc", "/vless-grpc", "/trojan-grpc"] },
    "v2ray": { "ports": [10022, 10023, 10024, 10032, 10033, 10034], "paths": ["/vmess-v2ray", "/vless-v2ray", "/trojan-v2ray"] },
    "ssh_ws": { "ports": [10015], "paths": ["/fightertunnelssh"] },
    "haproxy_public": [80, 443, 8080, 8443]
  },
  "_panel_own": {
    "prefix_paths": "/mx-",
    "ports_base": 11000,
    "public_entrypoints": {
      "ws_http": [80, 8080],
      "ws_tls": [443, 8443],
      "grpc_tls": [443, 8443]
    },
    "map": {
      "mx-vmess-ws": { "port": 11002, "path": "/mx-vmess" },
      "mx-vless-ws": { "port": 11003, "path": "/mx-vless" },
      "mx-trojan-ws": { "port": 11004, "path": "/mx-trojan-ws" },
      "mx-vmess-grpc": { "port": 11012, "serviceName": "mx-vmess-grpc" },
      "mx-vless-grpc": { "port": 11013, "serviceName": "mx-vless-grpc" },
      "mx-trojan-grpc": { "port": 11014, "serviceName": "mx-trojan-grpc" }
    }
  },
  "inbounds": [
    {
      "tag": "mx-vmess-ws",
      "remark": "VMess WS · HTTP 80/8080 · TLS 443/8443",
      "listen": "127.0.0.1",
      "port": 11002,
      "protocol": "vmess",
      "settings": {
        "clients": [],
        "decryption": "auto",
        "fallbacks": []
      },
      "streamSettings": {
        "network": "ws",
        "security": "none",
        "wsSettings": {
          "path": "/mx-vmess",
          "headers": {}
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls", "quic"]
      }
    },
    {
      "tag": "mx-vless-ws",
      "remark": "VLESS WS · HTTP 80/8080 · TLS 443/8443",
      "listen": "127.0.0.1",
      "port": 11003,
      "protocol": "vless",
      "settings": {
        "clients": [],
        "decryption": "none",
        "fallbacks": []
      },
      "streamSettings": {
        "network": "ws",
        "security": "none",
        "wsSettings": {
          "path": "/mx-vless",
          "headers": {}
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls", "quic"]
      }
    },
    {
      "tag": "mx-trojan-ws",
      "remark": "Trojan WS · HTTP 80/8080 · TLS 443/8443",
      "listen": "127.0.0.1",
      "port": 11004,
      "protocol": "trojan",
      "settings": {
        "clients": [],
        "fallbacks": []
      },
      "streamSettings": {
        "network": "ws",
        "security": "none",
        "wsSettings": {
          "path": "/mx-trojan-ws",
          "headers": {}
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls", "quic"]
      }
    },
    {
      "tag": "mx-vmess-grpc",
      "remark": "VMess gRPC · TLS/H2 443/8443",
      "listen": "127.0.0.1",
      "port": 11012,
      "protocol": "vmess",
      "settings": {
        "clients": [],
        "decryption": "auto"
      },
      "streamSettings": {
        "network": "grpc",
        "security": "none",
        "grpcSettings": {
          "serviceName": "mx-vmess-grpc",
          "multiMode": false
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls"]
      }
    },
    {
      "tag": "mx-vless-grpc",
      "remark": "VLESS gRPC · TLS/H2 443/8443",
      "listen": "127.0.0.1",
      "port": 11013,
      "protocol": "vless",
      "settings": {
        "clients": [],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "grpc",
        "security": "none",
        "grpcSettings": {
          "serviceName": "mx-vless-grpc",
          "multiMode": false
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls"]
      }
    },
    {
      "tag": "mx-trojan-grpc",
      "remark": "Trojan gRPC · TLS/H2 443/8443",
      "listen": "127.0.0.1",
      "port": 11014,
      "protocol": "trojan",
      "settings": {
        "clients": []
      },
      "streamSettings": {
        "network": "grpc",
        "security": "none",
        "grpcSettings": {
          "serviceName": "mx-trojan-grpc",
          "multiMode": false
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls"]
      }
    }
  ],
  "forbidden_public_ports": [80, 443, 8080, 8443, 54323],
  "public_entrypoints": {
    "ws_http": [80, 8080],
    "ws_tls": [443, 8443],
    "grpc_tls": [443, 8443],
    "note": "The installer creates loopback-only inbounds; HAProxy exposes WS on all four ports and gRPC over TLS/HTTP2 on 443 and 8443."
  },
  "client_example": "vless://<UUID>@<IP>:443?path=/mx-vless&security=tls&type=ws#MOVIVIP-PANEL"
}
